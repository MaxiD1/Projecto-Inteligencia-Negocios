                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT YEAR(v.fecha) * 10000 + MONTH(v.fecha) * 100 + DAY(v.fecha) AS tiempo_id,
       d.producto_id,
       v.cliente_id,
       v.sucursal_id,
       v.vendedor_id,
       v.venta_id,
       v.tipo_documento,
       d.cantidad,
       d.precio_unitario,
       d.descuento,
       d.cantidad * d.precio_unitario AS monto_bruto,
       d.cantidad * d.precio_unitario * (1 - d.descuento) AS monto_neto
FROM detalle_ventas d
INNER JOIN ventas v ON d.venta_id = v.venta_id</property>
